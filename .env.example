# Server-side only
OPENAI_API_KEY=
# Optional model overrides; otherwise inherit api/_lib/openai.js defaults.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_GRADER_MODEL=gpt-5.6-terra
DATABASE_URL=

# Token names are retained for compatibility with the shared engine.
# The bundled frontend token is a bot filter, not private user authentication.
LEO_API_TOKEN=
VITE_LEO_API_TOKEN=

# Voice uses the same OpenAI key.

# For the Node server
PORT=8080

# Sign-in for Jim. JIM_PASSWORD_HASH is a scrypt digest, never the password
# itself: generate it with `node scripts/hash-password.mjs`. Leaving it empty
# leaves the API open, which is the pre-login behaviour. Never use a VITE_
# variable for any of these.
JIM_USERNAME=jim
JIM_PASSWORD_HASH=
# Optional. Signs session cookies; defaults to a value derived from the
# password hash, so changing the password signs everyone out either way.
SESSION_SECRET=

# SHA-256 of the parent-only payout approval code. Never use a VITE_ variable.
PARENT_APPROVAL_HASH=

OPENAI_TAGGER_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
LEO_TTS_PROVIDER=openai
